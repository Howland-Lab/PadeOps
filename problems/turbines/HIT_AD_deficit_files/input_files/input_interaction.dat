&concurrent
HIT_InputFile                 = "/work2/08445/tg877441/stampede3/PadeOps/problems/turbines/HIT_AD_deficit_files/input_files/input_hit.dat"
AD_InputFile                  = "/work2/08445/tg877441/stampede3/PadeOps/problems/turbines/HIT_AD_deficit_files/input_files/input_AD.dat"
Empty_InputFile               = "/work2/08445/tg877441/stampede3/PadeOps/problems/turbines/HIT_AD_deficit_files/input_files/input_empty.dat"
InflowSpeed                   = 1.d0       ! advection velocity for HIT targets
k_bandpass_left               = 4.0d0      ! bandpass filter HIT lower
k_bandpass_right              = 128.d0     ! bandpass filter HIT upper
TI_target                     = 0.08d0     ! Target turbulence intensity sqrt(2/3k)/InflowSpeed. Set to -1 to disable
TI_xloc                       = 4.d0       ! x-location to compute TI for the TI controller and TI_target
TI_fact                       = -1         ! Amplifier for HIT fluctuations. Set to > 0 to enable manually
freeze_HIT                    = .false.    ! Freeze HIT targets? (e.g. for Mann turbulence)
/
/
&BUDGET_TIME_AVG_DEFICIT
do_budgets            = .false.    
budgetType            = 1         ! See type descriptions in budget_time_avg.F90
budgets_dir           = "null"    ! Write in default output directory
tidx_compute          = 1         ! How often should budgets be computed?
tidx_dump             = 1000      ! How often should budget files be written to disk?
tidx_budget_start     = -1        ! Start budget computation from this timestep onward
time_budget_start     = 100.d0    ! Start time for budget computation, -1 to disable
restart_budgets       = .FALSE.   ! use existing budget file to restart budget calculations?
restart_rid           = 2         ! Restart budget file run index
restart_tid           = 99999     ! Restart budget file time index
restart_counter       = 11111     ! Restart budget file counter
/
/
&FILTER_INFO
applyfilters = .FALSE. 
nfilters     = 2
fof_dir      = "/projects/windFlowModeling/PadeOps/HIT_Interact/filter_visualizations/"
tid_FIL_FullField = 75
tid_FIL_Planes = 4
filoutdir    = "/scratch/globus/aghate/filter_visualization/ad_data" 
/
/
